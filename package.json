{
  "name": "tradeloop",
  "version": "0.1.0",
  "description": "Sales follow-up and delivery issue coordination through AWS WhatsApp",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/local.ts",
    "web": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "vite build",
    "bundle": "node scripts/build.mjs",
    "synth": "cdk synth --app \"npx tsx infra/app.ts\"",
    "deploy": "cdk deploy --app \"npx tsx infra/app.ts\" --require-approval never --outputs-file .runtime/outputs.json",
    "format": "prettier --write src infra tests scripts *.ts package.json tsconfig.json",
    "verify": "npm run typecheck && npm test && npm run build && npm run bundle",
    "check:cloud": "tsx scripts/check-readiness.ts",
    "test:cloud": "tsx scripts/cloud-smoke.ts"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1158.0",
    "@aws-sdk/client-dynamodb": "^3.1158.0",
    "@aws-sdk/client-s3": "^3.1158.0",
    "@aws-sdk/client-sesv2": "^3.1158.0",
    "@aws-sdk/client-socialmessaging": "^3.1158.0",
    "@aws-sdk/client-sqs": "^3.1158.0",
    "@aws-sdk/client-textract": "^3.1158.0",
    "@aws-sdk/lib-dynamodb": "^3.1158.0",
    "@aws-sdk/s3-request-presigner": "^3.1158.0",
    "aws-cdk-lib": "^2.275.0",
    "aws-jwt-verify": "^5.2.1",
    "constructs": "^10.8.1",
    "express": "^5.3.0",
    "multer": "^2.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1158.0",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "aws-cdk": "^2.1146.1",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  },
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  }
}
